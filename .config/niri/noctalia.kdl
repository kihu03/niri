layout {

    focus-ring {
        active-color   "#c5caa5"
        inactive-color "#131311"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c5caa5"
        inactive-color "#131311"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#c5caa5"
        inactive-color "#22260d"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c5caa580"
    }
}

recent-windows {
    highlight {
        active-color "#c5caa5"
        urgent-color "#ffb4ab"
    }
}
